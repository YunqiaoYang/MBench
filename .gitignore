# --- demo: heavy artifacts are kept locally as symlinks pointing to the
#     full MBench-Data tree; on a public clone the user follows the cloud-drive
#     download instructions in demo/README.md instead. We track the directory
#     structure + JSON metadata + run_demo.sh + README,
#     and ignore videos, DA3 npz, ground-truth media, and run outputs. ---
demo/dataset/**/video.mp4
demo/dataset/**/source_video.mp4
demo/dataset/**/first_frame.png
demo/dataset/**/reference.png
demo/dataset/**/da3/results.npz
demo/output/

# --- maintainer-only helpers (depend on private data/ runs/ exp/ that aren't shipped):
#     _build_demo_data.py rebuilds demo/dataset by symlinking into ../data/MBench-Data,
#     scripts/ verifies the repo against ../runs and ../exp/analysis. Kept locally on
#     the maintainer's disk; not pushed to the public repo. ---
demo/_build_demo_data.py
scripts/